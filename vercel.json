{
  "functions": {
    "api/webhook.js": {
      "maxDuration": 60
    },
    "api/shorten.js": {
      "maxDuration": 15
    },
    "api/report.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/r/:file(.*\\..*)", "destination": "/:file" },
    { "source": "/r/:id", "destination": "/view.html?id=:id" },
    { "source": "/r", "destination": "/view.html" },
    { "source": "/view", "destination": "/view.html" }
  ]
}

